APP_NAME="PEKKA Bogor Istimewa"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
# Alamat situs. Dipakai untuk membuat tautan di email verifikasi, jadi harus sama
# dengan alamat yang dibuka ibu-ibu. Ganti dengan domain asli saat peluncuran.
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Kunci Gemini untuk Sahabat PEKKA. Buat sendiri di Google AI Studio. Jangan dibagikan.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pekka_bois
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# --- Email (Gmail) ---------------------------------------------------------
# 1. Akun Google harus memakai Verifikasi 2 Langkah.
# 2. Buat "Sandi aplikasi" di akun Google (myaccount.google.com > Keamanan > Sandi aplikasi).
# 3. Isi MAIL_USERNAME dengan alamat Gmail, MAIL_PASSWORD dengan 16 huruf sandi aplikasi
#    (tulis tanpa spasi). Itu BUKAN sandi login Gmail.
# 4. Uji dengan: php artisan email:uji alamat-tujuan@gmail.com
# Selama MAIL_MAILER=log, email tidak dikirim, hanya ditulis ke storage/logs/laravel.log.
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

# Akun operator pertama (admin dinas). Dibuat dengan: php artisan db:seed --class=AdminDinasSeeder
# Gunakan sandi yang kuat dan ganti sebelum peluncuran.
ADMIN_DINAS_EMAIL=
ADMIN_DINAS_PASSWORD=

VITE_APP_NAME="${APP_NAME}"
